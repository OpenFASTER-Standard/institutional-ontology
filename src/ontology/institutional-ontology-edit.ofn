Prefix(:=<https://purl.openfaster.org/io/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(IAO:=<http://purl.obolibrary.org/obo/IAO_>)
Prefix(BFO:=<http://purl.obolibrary.org/obo/BFO_>)
Prefix(IO:=<https://purl.openfaster.org/io/IO_>)
Prefix(dc:=<http://purl.org/dc/elements/1.1/>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)

Ontology(<https://purl.openfaster.org/io/institutional-ontology.owl>
Import(<http://purl.obolibrary.org/obo/bfo.owl>)
Import(<http://purl.obolibrary.org/obo/iao.owl>)
Annotation(dc:title "Institutional Ontology"@en)
Annotation(dc:description "A controlled vocabulary of formal/administrative (institutional, in Searle's sense) concepts, starting with German tax-reporting field alignment across the MiKaDiv and KaFE schemas."@en)
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)

# ============================================================= #
# IO:0000001 -- All given names / Alle Vornamen
# ============================================================= #
Declaration(Class(IO:0000001))
AnnotationAssertion(rdfs:label IO:0000001 "All given names"@en)
AnnotationAssertion(IAO:0000118 IO:0000001 "Alle Vornamen"@de)
AnnotationAssertion(IAO:0000115 IO:0000001 "A personal name that identifies an individual's given name(s) (first name and, where present, middle name(s)), as distinct from their family name."@en)
AnnotationAssertion(IAO:0000116 IO:0000001 "MiKaDiv XSD (ThirdPartyDisclosureRequest.xsd): FirstName EN \"The person's first name.\" / DE \"Vorname der Person.\" KaFE XSD (kafe-standardtypes.xsd, NatP_Struct): Vorname EN \"First and middle name\" / DE \"Vorname\". KaFE's Kommunikationshandbuch DIP-KAFE v1.4.0 confirms the field text explicitly covers middle names too (\"First and middle name. The length must not exceed 80 characters.\"). MiKaDiv's own handbook is silent on middle names but does not restrict the field to a single name either -- same real-world scope, hence skos:exactMatch not skos:closeMatch (see mappings/mikadiv-kafe.sssom.tsv). Confirmed to hold, verbatim, for KaFE's Ansprechperson_Struct.Vorname (contact person) too -- identical EN/DE documentation text to NatP_Struct.Vorname."@en)
AnnotationAssertion(IAO:0000119 IO:0000001 "MiKaDiv: ThirdPartyDisclosureRequest.xsd, IndividualPersonType.FirstName. KaFE: kafe-standardtypes.xsd, NatP_Struct.Vorname and Ansprechperson_Struct.Vorname. KaFE Kommunikationshandbuch DIP-KAFE v1.4.0."@en)
SubClassOf(IO:0000001 IAO:0000030)

# ============================================================= #
# IO:0000002 -- Last name / Nachname
# ============================================================= #
Declaration(Class(IO:0000002))
AnnotationAssertion(rdfs:label IO:0000002 "Last name"@en)
AnnotationAssertion(IAO:0000118 IO:0000002 "Nachname"@de)
AnnotationAssertion(IAO:0000115 IO:0000002 "A personal name that identifies an individual's family name (surname), as distinct from their given name(s)."@en)
AnnotationAssertion(IAO:0000116 IO:0000002 "MiKaDiv XSD (ThirdPartyDisclosureRequest.xsd): LastName EN \"The person's last name.\" / DE \"Nachname (Familienname) der Person.\" KaFE XSD (kafe-standardtypes.xsd, NatP_Struct): Nachname EN \"Last name\" / DE \"Nachname\". Both single-valued, no multi-value/ordering ambiguity (unlike given names) -- clean skos:exactMatch. Confirmed to hold, verbatim, for KaFE's Ansprechperson_Struct.Nachname (contact person) too -- identical EN/DE documentation text to NatP_Struct.Nachname."@en)
AnnotationAssertion(IAO:0000119 IO:0000002 "MiKaDiv: ThirdPartyDisclosureRequest.xsd, IndividualPersonType.LastName. KaFE: kafe-standardtypes.xsd, NatP_Struct.Nachname and Ansprechperson_Struct.Nachname."@en)
SubClassOf(IO:0000002 IAO:0000030)

# ============================================================= #
# IO:0000003 -- Form of address / Anredeform
# ============================================================= #
Declaration(Class(IO:0000003))
AnnotationAssertion(rdfs:label IO:0000003 "Form of address"@en)
AnnotationAssertion(IAO:0000118 IO:0000003 "Anredeform"@de)
AnnotationAssertion(IAO:0000115 IO:0000003 "A formal salutation used to address an individual, indicating their preferred title or the absence of one."@en)
AnnotationAssertion(IAO:0000116 IO:0000003 "KaFE XSD (kafe-standardtypes.xsd, NatP_Struct): Anrede, type Anrede_ENUM. Three permitted values, each modeled as a named individual of this class (IO:0000004/0000005/0000006), not a subclass -- corrected 2026-09-01 after research into real OBO/SKOS precedent for closed, non-hierarchical, never-extended enumerations (OBI's own categorical-value pattern; SKOS's skos:Concept is explicitly an individual, never a class, for exactly this scenario). \"Mr.\" is one value drawn from this category, not a kind of it. No MiKaDiv equivalent exists -- MiKaDiv's ThirdPartyDisclosureRequest.xsd has only a free-text Title field (a different concept: an honorific/qualification like \"Dr.\", not a form of address), so this concept is KaFE-only, unlike IO:0000001/IO:0000002."@en)
AnnotationAssertion(IAO:0000119 IO:0000003 "KaFE: kafe-standardtypes.xsd, NatP_Struct.Anrede and Anrede_ENUM."@en)
SubClassOf(IO:0000003 IAO:0000030)

# ============================================================= #
# IO:0000004 -- Ms. / Frau
# ============================================================= #
Declaration(NamedIndividual(IO:0000004))
AnnotationAssertion(rdfs:label IO:0000004 "Ms."@en)
AnnotationAssertion(IAO:0000118 IO:0000004 "Frau"@de)
AnnotationAssertion(IAO:0000115 IO:0000004 "The form of address for a woman."@en)
AnnotationAssertion(IAO:0000116 IO:0000004 "KaFE XSD (kafe-standardtypes.xsd, Anrede_ENUM): enumeration value FRAU, EN \"Ms\" / DE \"Frau\"."@en)
AnnotationAssertion(IAO:0000119 IO:0000004 "KaFE: kafe-standardtypes.xsd, Anrede_ENUM enumeration value FRAU."@en)
ClassAssertion(IO:0000003 IO:0000004)

# ============================================================= #
# IO:0000005 -- Mr. / Herr
# ============================================================= #
Declaration(NamedIndividual(IO:0000005))
AnnotationAssertion(rdfs:label IO:0000005 "Mr."@en)
AnnotationAssertion(IAO:0000118 IO:0000005 "Herr"@de)
AnnotationAssertion(IAO:0000115 IO:0000005 "The form of address for a man."@en)
AnnotationAssertion(IAO:0000116 IO:0000005 "KaFE XSD (kafe-standardtypes.xsd, Anrede_ENUM): enumeration value HERR, EN \"Mr\" / DE \"Herr\"."@en)
AnnotationAssertion(IAO:0000119 IO:0000005 "KaFE: kafe-standardtypes.xsd, Anrede_ENUM enumeration value HERR."@en)
ClassAssertion(IO:0000003 IO:0000005)

# ============================================================= #
# IO:0000006 -- No form of address / keine Anrede
# ============================================================= #
Declaration(NamedIndividual(IO:0000006))
AnnotationAssertion(rdfs:label IO:0000006 "No form of address"@en)
AnnotationAssertion(IAO:0000118 IO:0000006 "keine Anrede"@de)
AnnotationAssertion(IAO:0000115 IO:0000006 "The absence of a form of address, for an individual for whom none applies or is indicated."@en)
AnnotationAssertion(IAO:0000116 IO:0000006 "KaFE XSD (kafe-standardtypes.xsd, Anrede_ENUM): enumeration value KEINE_ANREDE, EN \"No form of address/no indication\" / DE \"keine Anrede\"."@en)
AnnotationAssertion(IAO:0000119 IO:0000006 "KaFE: kafe-standardtypes.xsd, Anrede_ENUM enumeration value KEINE_ANREDE."@en)
ClassAssertion(IO:0000003 IO:0000006)

# ============================================================= #
# IO:0000007 -- Person role / Personenrolle
# ============================================================= #
Declaration(Class(IO:0000007))
AnnotationAssertion(rdfs:label IO:0000007 "Person role"@en)
AnnotationAssertion(IAO:0000118 IO:0000007 "Personenrolle"@de)
AnnotationAssertion(IAO:0000115 IO:0000007 "The capacity in which a natural or legal person participates in a given request or filing, as one of a closed, enumerated set of real-world roles."@en)
AnnotationAssertion(IAO:0000116 IO:0000007 "KaFE XSD (kafe.xsd/kafe-standardtypes.xsd): not a real XSD field -- KaFE structurally distinguishes role via which wrapper element a NatP_Struct-shaped person appears under (SteuerpflichtigePerson, GesetzlicheVertretung, BevollmaechtigtePerson), never via an explicit enumerated field. This concept and its three individuals (IO:0000008/0000009/0000010) exist so the A-box can tag which of those three real structural roles a given ingested person-row plays, disambiguating \"whose given name\" once a submission can contain many people across many Erstattungsantrag entries -- see bulk-platform's docs/superpowers/specs/2026-09-02-nested-repeating-entity-abox-design.md. Same closed/non-hierarchical/never-extended shape as IO:0000003 (Anrede), same individuals-not-subclasses modeling choice. No MiKaDiv equivalent identified yet -- KaFE-only until a second real framework confirms or refines this concept's scope, same caveat IO:0000003 already carries."@en)
AnnotationAssertion(IAO:0000119 IO:0000007 "KaFE: kafe.xsd AllgAngaben_CType.SteuerpflichtigePerson/GesetzlicheVertretung, KAFE_CType.BevollmaechtigtePerson -- structural role distinction, not a real XSD enumerated field."@en)
SubClassOf(IO:0000007 IAO:0000030)

# ============================================================= #
# IO:0000008 -- Taxpayer / Steuerpflichtige Person
# ============================================================= #
Declaration(NamedIndividual(IO:0000008))
AnnotationAssertion(rdfs:label IO:0000008 "Taxpayer"@en)
AnnotationAssertion(IAO:0000118 IO:0000008 "Steuerpflichtige Person"@de)
AnnotationAssertion(IAO:0000115 IO:0000008 "The natural or legal person whose tax liability is the subject of a request or filing."@en)
AnnotationAssertion(IAO:0000116 IO:0000008 "KaFE XSD (kafe.xsd, AllgAngaben_CType): SteuerpflichtigePerson, type StpflPerson_Struct -- required, once per Erstattungsantrag."@en)
AnnotationAssertion(IAO:0000119 IO:0000008 "KaFE: kafe.xsd, AllgAngaben_CType.SteuerpflichtigePerson."@en)
ClassAssertion(IO:0000007 IO:0000008)

# ============================================================= #
# IO:0000009 -- Legal representative / Gesetzliche Vertretung
# ============================================================= #
Declaration(NamedIndividual(IO:0000009))
AnnotationAssertion(rdfs:label IO:0000009 "Legal representative"@en)
AnnotationAssertion(IAO:0000118 IO:0000009 "Gesetzliche Vertretung"@de)
AnnotationAssertion(IAO:0000115 IO:0000009 "The natural or legal person who legally represents another party in a request or filing."@en)
AnnotationAssertion(IAO:0000116 IO:0000009 "KaFE XSD (kafe.xsd, AllgAngaben_CType): GesetzlicheVertretung, type GesetzlicheVertretung_Struct -- optional, at most once per Erstattungsantrag."@en)
AnnotationAssertion(IAO:0000119 IO:0000009 "KaFE: kafe.xsd, AllgAngaben_CType.GesetzlicheVertretung."@en)
ClassAssertion(IO:0000007 IO:0000009)

# ============================================================= #
# IO:0000010 -- Authorised representative / Bevollmächtigte Person
# ============================================================= #
Declaration(NamedIndividual(IO:0000010))
AnnotationAssertion(rdfs:label IO:0000010 "Authorised representative"@en)
AnnotationAssertion(IAO:0000118 IO:0000010 "Bevollmächtigte Person"@de)
AnnotationAssertion(IAO:0000115 IO:0000010 "The natural or legal person authorised, typically via a granted power of attorney, to act on behalf of another party in a request or filing."@en)
AnnotationAssertion(IAO:0000116 IO:0000010 "KaFE XSD (kafe.xsd, KAFE_CType): BevollmaechtigtePerson, type BevollmaechtigtePerson_CType -- optional, at most once per whole submission, not per Erstattungsantrag (structurally a sibling of Antraege at the document root, confirmed directly against kafe.xsd lines 553-563)."@en)
AnnotationAssertion(IAO:0000119 IO:0000010 "KaFE: kafe.xsd, KAFE_CType.BevollmaechtigtePerson."@en)
ClassAssertion(IO:0000007 IO:0000010)

)
